# ---------------------------------------------------------------------------
# Backend URLs
# ---------------------------------------------------------------------------
# Rewrites in next.config.mjs send /api/* and /ws/* to these. Change them if the
# FastAPI server is not on the default local port.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_WS_URL=ws://127.0.0.1:8000

# Exposed to the browser bundle. Only needed when the dashboard is served from a
# different origin than the API (e.g. a deployed preview).
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Python backend (read by backend/config.py; put these in the shell or a .env
# loaded by python-dotenv, not here)
# ---------------------------------------------------------------------------
# NASA_BATTERY_DATA_ROOT=C:/path/to/BatteryData
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=info